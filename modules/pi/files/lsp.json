{
  "version": 1,
  "servers": [
    {
      "id": "nixd",
      "enabled": true,
      "include": ["**/*.nix"],
      "exclude": ["**/.direnv/**", "**/.git/**"],
      "rootMarkers": ["flake.nix", ".git"],
      "bin": "nixd",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".nix": "nix"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500
    },
    {
      "id": "gopls",
      "enabled": true,
      "include": ["**/*.go"],
      "exclude": ["**/.git/**", "**/vendor/**"],
      "rootMarkers": ["go.work", "go.mod", ".git"],
      "bin": "gopls",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".go": "go"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500
    },
    {
      "id": "typescript",
      "enabled": true,
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.mts",
        "**/*.cts",
        "**/*.mjs",
        "**/*.cjs"
      ],
      "exclude": ["**/.git/**", "**/build/**", "**/dist/**", "**/node_modules/**"],
      "rootMarkers": ["tsconfig.json", "jsconfig.json", "package.json", ".git"],
      "bin": "typescript-language-server",
      "args": ["--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500
    },
    {
      "id": "json",
      "enabled": true,
      "include": ["**/*.json", "**/*.jsonc"],
      "exclude": ["**/.git/**", "**/build/**", "**/dist/**", "**/node_modules/**"],
      "rootMarkers": ["package.json", ".git"],
      "bin": "vscode-json-language-server",
      "args": ["--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".json": "json",
        ".jsonc": "jsonc"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1000
    },
    {
      "id": "css",
      "enabled": true,
      "include": ["**/*.css", "**/*.scss", "**/*.less"],
      "exclude": ["**/.git/**", "**/build/**", "**/dist/**", "**/node_modules/**"],
      "rootMarkers": ["package.json", ".git"],
      "bin": "vscode-css-language-server",
      "args": ["--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".css": "css",
        ".scss": "scss",
        ".less": "less"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1000
    },
    {
      "id": "html",
      "enabled": true,
      "include": ["**/*.html", "**/*.htm"],
      "exclude": ["**/.git/**", "**/build/**", "**/dist/**", "**/node_modules/**"],
      "rootMarkers": ["package.json", ".git"],
      "bin": "vscode-html-language-server",
      "args": ["--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".html": "html",
        ".htm": "html"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1000
    },
    {
      "id": "lua",
      "enabled": true,
      "include": ["**/*.lua"],
      "exclude": ["**/.git/**", "**/build/**"],
      "rootMarkers": [".luarc.json", ".luarc.jsonc", ".git"],
      "bin": "lua-language-server",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".lua": "lua"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500
    },
    {
      "id": "bash",
      "enabled": true,
      "include": ["**/*.sh", "**/*.bash", "**/*.zsh"],
      "exclude": ["**/.git/**", "**/node_modules/**"],
      "rootMarkers": [".git"],
      "bin": "bash-language-server",
      "args": ["start"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".sh": "shellscript",
        ".bash": "shellscript",
        ".zsh": "shellscript"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1000
    },
    {
      "id": "terraform",
      "enabled": true,
      "include": ["**/*.tf", "**/*.tfvars"],
      "exclude": ["**/.git/**", "**/.terraform/**"],
      "rootMarkers": [".terraform.lock.hcl", ".git"],
      "bin": "terraform-ls",
      "args": ["serve"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".tf": "terraform",
        ".tfvars": "terraform-vars"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500
    },
    {
      "id": "metals",
      "enabled": true,
      "include": ["**/*.scala", "**/*.sc", "**/*.sbt"],
      "exclude": ["**/.bloop/**", "**/.git/**", "**/.metals/**", "**/target/**"],
      "rootMarkers": ["build.sbt", "build.sc", ".git"],
      "bin": "metals",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".scala": "scala",
        ".sc": "scala",
        ".sbt": "sbt"
      },
      "startupTimeoutMs": 120000,
      "diagnosticsWaitMs": 3000
    },
    {
      "id": "ty",
      "enabled": true,
      "include": ["**/*.py", "**/*.pyi"],
      "exclude": ["**/.git/**", "**/.venv/**", "**/__pycache__/**", "**/site-packages/**"],
      "rootMarkers": ["pyproject.toml", "uv.lock", "setup.py", "requirements.txt", ".git"],
      "bin": "ty",
      "args": ["server"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".py": "python",
        ".pyi": "python"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500
    },
    {
      "id": "yaml",
      "enabled": true,
      "include": ["**/*.yaml", "**/*.yml"],
      "exclude": ["**/.git/**", "**/build/**", "**/dist/**", "**/node_modules/**"],
      "rootMarkers": [".git"],
      "bin": "yaml-language-server",
      "args": ["--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".yaml": "yaml",
        ".yml": "yaml"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1000
    },
    {
      "id": "marksman",
      "enabled": true,
      "include": ["**/*.md", "**/*.markdown"],
      "exclude": ["**/.git/**", "**/build/**", "**/dist/**", "**/node_modules/**"],
      "rootMarkers": [".marksman.toml", ".git"],
      "bin": "marksman",
      "args": ["server"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".md": "markdown",
        ".markdown": "markdown"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1000
    },
    {
      "id": "taplo",
      "enabled": true,
      "include": ["**/*.toml"],
      "exclude": ["**/.git/**", "**/build/**", "**/dist/**", "**/node_modules/**", "**/target/**"],
      "rootMarkers": ["taplo.toml", ".taplo.toml", "Cargo.toml", "pyproject.toml", ".git"],
      "bin": "taplo",
      "args": ["lsp", "stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".toml": "toml"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1000
    },
    {
      "id": "rust-analyzer",
      "enabled": true,
      "include": ["**/*.rs"],
      "exclude": ["**/.git/**", "**/target/**"],
      "rootMarkers": ["Cargo.toml", ".git"],
      "bin": "rust-analyzer",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".rs": "rust"
      },
      "startupTimeoutMs": 120000,
      "diagnosticsWaitMs": 3000
    }
  ]
}
