{
  "theme": "system",
  "defaultProvider": "openai",
  "quietStartup": "header",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question@2.12.0",
    "npm:pi-lsp@0.1.7",
    "npm:pi-web-access@0.32.0",
    {
      "source": "npm:pi-subagents@0.72.0",
      "skills": [],
      "prompts": []
    }
  ],
  "subagents": {
    "defaultModel": "openai/gpt-6.1-sol",
    "defaultThinking": "medium",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai/gpt-6-luna",
        "openai/gpt-6.1-sol",
        "openai/gpt-6-astra"
      ]
    },
    "agentOverrides": {
      "scout": {
        "model": "openai/gpt-6-luna",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "intercom"
        ]
      },
      "researcher": {
        "model": "openai/gpt-6-luna",
        "thinking": "low",
        "inheritProjectContext": false,
        "tools": [
          "read",
          "web_search",
          "fetch_content",
          "get_search_content",
          "intercom"
        ]
      },
      "worker": {
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "thinking": "high",
        "acceptanceRole": "read-only",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "intercom"
        ]
      },
      "context-builder": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "web_search",
          "intercom"
        ]
      },
      "planner": {
        "model": "openai/gpt-6.1-sol",
        "defaultContext": "fresh"
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "defaultContext": "fresh"
      },
      "delegate": {
        "disabled": true
      }
    }
  },
  "editorPaddingX": 1,
  "showHardwareCursor": true
}
