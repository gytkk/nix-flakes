     #[test]
+    fn separator_custom_status_tokens_use_plain_space() {
+        let label = ResolvedToken::unstyled(ResolvedTokenKind::Custom("worker".into()));
+
+        for status in ["●", "✓", "■", "×", "○", "…"] {
+            let status = ResolvedToken::unstyled(ResolvedTokenKind::Custom(status.into()));
+            assert_eq!(separator(&status, &label), " ");
+        }
+
+        let ordinary = ResolvedToken::unstyled(ResolvedTokenKind::Custom("ordinary".into()));
+        assert_eq!(separator(&ordinary, &label), " · ");
+
+        let state_icon = ResolvedToken::unstyled(ResolvedTokenKind::StateIcon);
+        assert_eq!(separator(&state_icon, &label), " ");
+
+        let git_status = ResolvedToken::unstyled(ResolvedTokenKind::GitStatus {
+            ahead: 1,
+            behind: 0,
+        });
+        assert_eq!(separator(&label, &git_status), " ");
+    }
