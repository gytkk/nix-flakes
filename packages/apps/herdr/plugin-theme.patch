+fn plugin_theme_json(palette: &crate::app::state::Palette) -> serde_json::Result<String> {
+    serde_json::to_string(&serde_json::json!({
+        "version": 1,
+        "selection_bg": palette.selection_bg.to_string(),
+        "panel_bg": palette.panel_bg.to_string(),
+        "surface0": palette.surface0.to_string(),
+        "surface1": palette.surface1.to_string(),
+        "text": palette.text.to_string(),
+        "accent": palette.accent.to_string(),
+        "yellow": palette.yellow.to_string(),
+        "green": palette.green.to_string(),
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use ratatui::style::Color;
+
+    use super::*;
+
+    #[test]
+    fn plugin_theme_snapshot_is_versioned_and_preserves_color_strings() {
+        let mut palette = crate::app::state::Palette::catppuccin();
+        palette.selection_bg = Color::Indexed(238);
+        palette.panel_bg = Color::Reset;
+
+        let value: serde_json::Value =
+            serde_json::from_str(&plugin_theme_json(&palette).expect("theme serializes"))
+                .expect("theme is JSON");
+
+        assert_eq!(value["version"], 1);
+        assert_eq!(value["selection_bg"], "238");
+        assert_eq!(value["panel_bg"], "Reset");
+        assert_eq!(value["surface0"], palette.surface0.to_string());
+        assert_eq!(value["surface1"], palette.surface1.to_string());
+        assert_eq!(value["text"], palette.text.to_string());
+        assert_eq!(value["accent"], palette.accent.to_string());
+        assert_eq!(value["yellow"], palette.yellow.to_string());
+        assert_eq!(value["green"], palette.green.to_string());
+    }
+
+    #[test]
+    fn plugin_theme_environment_key_is_protected() {
+        assert!(plugin_pane_protected_env_key("HERDR_PLUGIN_THEME_JSON"));
+    }
+}
