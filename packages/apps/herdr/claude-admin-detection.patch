+fn claude_entrypoint_index(argv: &[String]) -> Option<usize> {
+    let is_claude =
+        |arg: &str| agent_name_from_path_token(arg).as_deref() == Some(agent_label(Agent::Claude));
+    if argv.first().is_some_and(|arg| is_claude(arg)) {
+        return Some(0);
+    }
+
+    let runtime = argv
+        .first()
+        .map(|arg| normalized_agent_lookup_name(path_basename(arg)))?;
+    if !matches!(runtime.as_str(), "node" | "bun") {
+        return None;
+    }
+    argv.get(1).is_some_and(|arg| is_claude(arg)).then_some(1)
+}
+
+fn is_claude_maintenance_process(process: &crate::platform::ForegroundProcess) -> bool {
+    let Some(argv) = process.argv.as_deref() else {
+        return false;
+    };
+    let Some(entrypoint) = claude_entrypoint_index(argv) else {
+        return false;
+    };
+
+    argv.get(entrypoint + 1).is_some_and(|arg| {
+        matches!(
+            arg.as_str(),
+            "plugin" | "plugins" | "mcp" | "--version" | "-v" | "--help" | "-h"
+        )
+    })
+}
+
+fn is_interactive_agent_process(
+    agent: Agent,
+    process: &crate::platform::ForegroundProcess,
+) -> bool {
+    match agent {
+        Agent::Claude => !is_claude_maintenance_process(process),
+        Agent::Letta => is_interactive_letta_process(process),
+        _ => true,
+    }
 }

