 impl ThemeConfig {
+    pub(crate) fn for_herdr(self) -> Result<Self> {
+        if std::env::var("HERDR_ENV").as_deref() != Ok("1") {
+            return Ok(self);
+        }
+        match std::env::var("HERDR_PLUGIN_THEME_JSON") {
+            Ok(json) => self.inherit_herdr(&json).context("in HERDR_PLUGIN_THEME_JSON"),
+            Err(std::env::VarError::NotPresent) => Ok(self),
+            Err(err) => Err(err).context("reading HERDR_PLUGIN_THEME_JSON"),
+        }
+    }
+
+    fn inherit_herdr(self, json: &str) -> Result<Self> {
+        #[derive(Deserialize)]
+        struct Snapshot {
+            version: u32,
+            selection_bg: String,
+            surface0: String,
+            surface1: String,
+            accent: String,
+        }
+        let palette: Snapshot = serde_json::from_str(json).context("parsing Herdr theme snapshot")?;
+        anyhow::ensure!(palette.version == 1, "unsupported Herdr theme snapshot version {}", palette.version);
+        let color = |key: &str, value: &str| {
+            value.parse::<Color>().with_context(|| format!("invalid Herdr theme color {key}: {value:?}"))
+        };
+        Ok(Self {
+            selection_background: self
+                .selection_background
+                .or(Some(color("selection_bg", &palette.selection_bg)?)),
+            comment_background: self.comment_background.or(Some(color("surface0", &palette.surface0)?)),
+            looks_good_background: self.looks_good_background.or(Some(color("surface1", &palette.surface1)?)),
+            markdown_code_foreground: self
+                .markdown_code_foreground
+                .or(Some(color("accent", &palette.accent)?)),
+        })
+    }
