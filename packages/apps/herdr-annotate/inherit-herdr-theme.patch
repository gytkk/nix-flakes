+    fn inherited_herdr_colors_preserve_terminal_color_types_and_local_overrides() {
+        let json = r##"{"version":1,"selection_bg":"#cddbf8","surface0":"Reset","surface1":"238","accent":"Blue","future_role":"ignored"}"##;
+        let inherited = ThemeConfig::default().inherit_herdr(json).expect("snapshot");
+        assert_eq!(inherited.selection_background(), Color::Rgb(205, 219, 248));
+        assert_eq!(inherited.comment_background(), Color::Reset);
+        assert_eq!(inherited.looks_good_background(), Color::Indexed(238));
+        assert_eq!(inherited.markdown_code_foreground(), Color::Blue);
+        let config = Config::parse("[theme]\ncomment_background = \"#fff0c2\"\n").expect("config");
+        let overridden = config.theme.inherit_herdr(json).expect("snapshot");
+        assert_eq!(overridden.comment_background(), Color::Rgb(255, 240, 194));
+        assert_eq!(overridden.selection_background(), inherited.selection_background());
+        assert_eq!(overridden.looks_good_background(), inherited.looks_good_background());
+        assert_eq!(overridden.markdown_code_foreground(), inherited.markdown_code_foreground());
+    }
