+#[test]
+fn inherited_one_light_colors_cover_the_document_and_preserve_highlights() {
+    use ratatui::style::Color;
+    let json = r##"{"version":1,"panel_bg":"#fafafa","text":"#383a42","selection_bg":"#cddbf8","surface0":"#f0f0f1","surface1":"#e5e5e6","accent":"#4078f2"}"##;
+    for kind in [None, Some(Kind::Comment), Some(Kind::LooksGood)] {
+        let mut app = app(Box::new(Discard));
+        app.set_theme(Config::default().theme.inherit_herdr(json).expect("snapshot"));
+        if let Some(kind) = kind {
+            app.add_block_annotation(0, kind, "review".to_owned()).expect("annotation");
+        }
+        let mut terminal = Terminal::new(TestBackend::new(80, 20)).expect("terminal");
+        terminal.draw(|frame| app.draw(frame)).expect("draw");
+        let buffer = terminal.backend().buffer();
+        let doc = app.geometry.doc;
+        let plain = (doc.y..doc.bottom())
+            .flat_map(|y| (doc.x..doc.right()).filter_map(move |x| buffer.cell((x, y))))
+            .find(|cell| cell.symbol() == "f")
+            .expect("first thing");
+        assert_eq!(plain.bg, Color::Rgb(250, 250, 250));
+        assert_eq!(plain.fg, Color::Rgb(56, 58, 66));
+        let padding = buffer.cell((app.geometry.doc.x, app.geometry.doc.bottom() - 1)).expect("padding");
+        assert_eq!(padding.bg, Color::Rgb(250, 250, 250));
+        let selected = buffer.cell((app.geometry.doc.x, app.geometry.doc.y)).expect("selected heading");
+        let expected = match kind {
+            None => Color::Rgb(205, 219, 248),
+            Some(Kind::Comment) => Color::Rgb(240, 240, 241),
+            Some(Kind::LooksGood) => Color::Rgb(229, 229, 230),
+            Some(_) => unreachable!(),
+        };
+        assert_eq!(selected.bg, expected);
+    }
