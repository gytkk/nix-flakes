 /// How the app looks. One key so far; the colours themselves are not configurable yet.
 #[derive(Debug, Clone, PartialEq, Eq, Default, Serialize, Deserialize)]
 #[serde(deny_unknown_fields, default)]
 pub(crate) struct UiConfig {
     /// `auto` asks the terminal for its background colour; `light` and `dark` skip the
     /// question. `PLANNOTATOR_TUI_THEME` overrides whatever is written here.
     pub(crate) theme: ThemeSetting,
+}
+
+/// Colors used by the review UI.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Serialize, Deserialize)]
+#[serde(deny_unknown_fields, default)]
+pub(crate) struct ThemeConfig {
+    #[serde(
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "deserialize_rgb_color",
+        serialize_with = "serialize_rgb_color"
+    )]
+    selection_background: Option<Color>,
+    #[serde(
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "deserialize_rgb_color",
+        serialize_with = "serialize_rgb_color"
+    )]
+    comment_background: Option<Color>,
+    #[serde(
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "deserialize_rgb_color",
+        serialize_with = "serialize_rgb_color"
+    )]
+    looks_good_background: Option<Color>,
+    #[serde(
+        skip_serializing_if = "Option::is_none",
+        deserialize_with = "deserialize_rgb_color",
+        serialize_with = "serialize_rgb_color"
+    )]
+    markdown_code_foreground: Option<Color>,
+}
+
+impl ThemeConfig {
+    pub(crate) fn selection_background(&self) -> Color {
+        self.selection_background.unwrap_or_else(|| crate::theme::palette().block_bg)
+    }
+
+    pub(crate) fn comment_background(&self) -> Color {
+        self.comment_background.unwrap_or_else(|| crate::theme::palette().comment_bg)
+    }
+
+    pub(crate) fn looks_good_background(&self) -> Color {
+        self.looks_good_background.unwrap_or_else(|| crate::theme::palette().approve_bg)
+    }
+
+    pub(crate) fn markdown_code_foreground(&self) -> Color {
+        self.markdown_code_foreground.unwrap_or(Color::LightYellow)
+    }
+}
+
+fn deserialize_rgb_color<'de, D>(deserializer: D) -> std::result::Result<Option<Color>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    let value = String::deserialize(deserializer)?;
+    let Some(hex) = value.strip_prefix('#') else {
+        return Err(serde::de::Error::custom(format!("expected a color in #RRGGBB format, got {value:?}")));
+    };
+    if hex.len() != 6 || !hex.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        return Err(serde::de::Error::custom(format!("expected a color in #RRGGBB format, got {value:?}")));
+    }
+    let rgb = u32::from_str_radix(hex, 16).map_err(serde::de::Error::custom)?;
+    let [_, red, green, blue] = rgb.to_be_bytes();
+    Ok(Some(Color::Rgb(red, green, blue)))
+}
+
+#[allow(
+    clippy::ref_option,
+    clippy::trivially_copy_pass_by_ref,
+    reason = "serde's serialize_with callback receives a reference to the field"
+)]
+fn serialize_rgb_color<S>(color: &Option<Color>, serializer: S) -> std::result::Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+{
+    match color {
+        Some(Color::Rgb(red, green, blue)) => {
+            serializer.serialize_some(&format!("#{red:02x}{green:02x}{blue:02x}"))
+        }
+        None => serializer.serialize_none(),
+        Some(_) => Err(serde::ser::Error::custom("theme color is not an RGB color")),
+    }
 }

