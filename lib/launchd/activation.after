            processAgent() {
              local srcPath="$1"
              local dstDir="$2"
              local oldDomainsDir="$4"
              local newDomainsDir="$5"

              local agentFile="''${srcPath##*/}"
              local agentName="''${agentFile%.plist}"
              local dstPath="$dstDir/$agentFile"
              local backupPath=""
              local oldDomainName newDomainName oldDomain newDomain
              local oldAgentBootedOut=0

              oldDomainName="$(readAgentDomain "$oldDomainsDir" "$agentName")"
              newDomainName="$(readAgentDomain "$newDomainsDir" "$agentName")"
              oldDomain="$(resolveDomain "$oldDomainName")"
              newDomain="$(resolveDomain "$newDomainName")"

              if cmp -s "$srcPath" "$dstPath" && [[ "$oldDomainName" == "$newDomainName" ]]; then
                if agentIsLoaded "$newDomain" "$agentName"; then
                  verboseEcho "Agent '$newDomain/$agentName' is already up-to-date"
                  return 0
                fi
              fi

              verboseEcho "Processing agent '$newDomain/$agentName'"
              if [[ -f "$dstPath" ]]; then
                backupPath="$dstDir/.''${agentFile}.home-manager-backup"
                if [[ -z "''${DRY_RUN_CMD:-}" ]]; then
                  backupPath="$(mktemp "$dstDir/.''${agentName}.XXXXXX")" || return 1
                  if ! run cp "$dstPath" "$backupPath"; then
                    run rm -f "$backupPath"
                    return 1
                  fi
                fi
                bootoutAgent "$oldDomain" "$agentName"
                case "$?" in
                  0) oldAgentBootedOut=1 ;;
                  2) ;;
                  *) run rm -f "$backupPath"; return 1 ;;
                esac
              fi

              if [[ "$oldDomainName" != "$newDomainName" ]]; then
                bootoutAgent "$newDomain" "$agentName"
                case "$?" in
                  0|2) ;;
                  *)
                    if [[ "$oldAgentBootedOut" -eq 1 ]]; then
                      restoreAgent "$backupPath" "$dstPath" "$oldDomain" "$agentName" || warnEcho "Previous agent '$oldDomain/$agentName' could not be restored"
                    fi
                    [[ -z "$backupPath" ]] || run rm -f "$backupPath"
                    return 1
                    ;;
                esac
              fi

              if installAgentFile "$srcPath" "$dstPath" "$agentName" && bootstrapAgent "$newDomain" "$dstPath" "$agentName"; then
                [[ -z "$backupPath" ]] || run rm -f "$backupPath"
                return 0
              fi

              if [[ -n "$backupPath" ]]; then
                restoreAgent "$backupPath" "$dstPath" "$oldDomain" "$agentName" || warnEcho "Previous agent '$oldDomain/$agentName' could not be restored"
                run rm -f "$backupPath"
              else
                run rm -f "$dstPath"
              fi
              return 1
            }
