            # macOS 26 added launchctl bootout --wait. Earlier releases use a
            # plain bootout and wait before replacing the plist.
            version="$(/usr/bin/sw_vers --productVersion | cut -d. -f 1)"
            set +e

            bootoutAgent() {
              local domain="$1" agentName="$2" bootout_output
              verboseEcho "Stopping agent '$domain/$agentName'..."
              if [[ "$version" -ge 26 ]]; then
                bootout_output=$(run /bin/launchctl bootout --wait "$domain/$agentName" 2>&1) && return 0
              else
                bootout_output=$(run /bin/launchctl bootout "$domain/$agentName" 2>&1) && {
                  run sleep 1
                  return 0
                }
              fi
              if [[ "$bootout_output" == *"No such process"* || "$bootout_output" == *"Domain does not support specified action"* ]]; then
                verboseEcho "Agent '$domain/$agentName' was not running"
                return 2
              fi
              errorEcho "Failed to stop agent '$domain/$agentName': $bootout_output"
              return 1
            }

            installAgentFile() {
              local srcPath="$1" dstPath="$2" agentName="$3"
              verboseEcho "Installing agent file to $dstPath"
              run install -Dm444 -T "$srcPath" "$dstPath" || {
                errorEcho "Failed to install agent file for '$agentName'"
                return 1
              }
            }

            bootstrapAgent() {
              local domain="$1" dstPath="$2" agentName="$3" bootstrap_output
              verboseEcho "Starting agent '$domain/$agentName'"
              bootstrap_output=$(run /bin/launchctl bootstrap "$domain" "$dstPath" 2>&1) || {
                errorEcho "Failed to start agent '$domain/$agentName': $bootstrap_output"
                return 1
              }
              verboseEcho "Successfully started agent '$domain/$agentName'"
            }

            restoreAgent() {
              local oldSrcPath="$1" dstPath="$2" domain="$3" agentName="$4"
              [[ -f "$oldSrcPath" ]] || return 0
              warnEcho "Restoring previous agent '$domain/$agentName' after replacement failure"
              installAgentFile "$oldSrcPath" "$dstPath" "$agentName" && bootstrapAgent "$domain" "$dstPath" "$agentName" || {
                errorEcho "Failed to restore previous agent '$domain/$agentName'"
                return 1
              }
            }

            processAgent() {
              local srcPath="$1" dstDir="$2" domain="$3"
              local agentFile="''${srcPath##*/}"
              local agentName="''${agentFile%.plist}"
              local dstPath="$dstDir/$agentFile"
              local backupPath=""
              if cmp -s "$srcPath" "$dstPath"; then
                verboseEcho "Agent '$agentName' is already up-to-date"
                return 0
              fi
              verboseEcho "Processing agent '$agentName'"
              if [[ -f "$dstPath" ]]; then
                backupPath="$dstDir/.''${agentFile}.home-manager-backup"
                if [[ -z "''${DRY_RUN_CMD:-}" ]]; then
                  backupPath="$(mktemp "$dstDir/.''${agentName}.XXXXXX")"
                  run cp "$dstPath" "$backupPath" || return 1
                fi
                bootoutAgent "$domain" "$agentName"
                case "$?" in 0|2) ;; *) run rm -f "$backupPath"; return 1 ;; esac
              fi
              if ! installAgentFile "$srcPath" "$dstPath" "$agentName"; then
                restoreAgent "$backupPath" "$dstPath" "$domain" "$agentName" || warnEcho "Previous agent '$domain/$agentName' could not be restored"
                [[ -z "$backupPath" ]] || run rm -f "$backupPath"
                [[ -n "$backupPath" ]] || run rm -f "$dstPath"
                return 1
              fi
              if ! bootstrapAgent "$domain" "$dstPath" "$agentName"; then
                restoreAgent "$backupPath" "$dstPath" "$domain" "$agentName" || warnEcho "Previous agent '$domain/$agentName' could not be restored"
                [[ -z "$backupPath" ]] || run rm -f "$backupPath"
                [[ -n "$backupPath" ]] || run rm -f "$dstPath"
                return 1
              fi
              [[ -z "$backupPath" ]] || run rm -f "$backupPath"
            }

            removeAgent() {
              local srcPath="$1" dstDir="$2" newDir="$3" domain="$4"
              local agentFile="''${srcPath##*/}"
              local agentName="''${agentFile%.plist}"
              local dstPath="$dstDir/$agentFile"
              [[ -e "$newDir/$agentFile" ]] && return 0
              [[ -e "$dstPath" ]] || return 0
              cmp -s "$srcPath" "$dstPath" || {
                warnEcho "Skipping deletion of '$dstPath', since its contents have diverged"
                return 0
              }
              bootoutAgent "$domain" "$agentName"
              case "$?" in 0|2) ;; *) return 1 ;; esac
              verboseEcho "Removing agent file '$dstPath'"
              run rm -f $VERBOSE_ARG "$dstPath" || return 1
            }

            setupLaunchAgents() {
              local oldDir newDir dstDir domain launchdStatus=0
              newDir="$(readlink -m "$newGenPath/LaunchAgents")"
              dstDir=${lib.escapeShellArg dstDir}
              domain="gui/$UID"
              if [[ -n "''${oldGenPath:-}" && -d "$oldGenPath/LaunchAgents" ]]; then
                oldDir="$(readlink -m "$oldGenPath/LaunchAgents")"
              else
                oldDir=""
              fi
              [[ -d "$dstDir" ]] || run mkdir -p "$dstDir" || return 1
              while IFS= read -r srcPath; do
                processAgent "$srcPath" "$dstDir" "$domain" || launchdStatus=1
              done < <(find -L "$newDir" -maxdepth 1 -name '*.plist' -type f)
              if [[ -n "$oldDir" ]]; then
                while IFS= read -r srcPath; do
                  removeAgent "$srcPath" "$dstDir" "$newDir" "$domain" || launchdStatus=1
                done < <(find -L "$oldDir" -maxdepth 1 -name '*.plist' -type f)
              fi
              [[ "$launchdStatus" -eq 0 ]] || errorEcho "Failed to activate one or more LaunchAgents"
              return "$launchdStatus"
            }

            launchdStatus=0
            setupLaunchAgents || launchdStatus=$?

            # Restore errexit and propagate the aggregate lifecycle failure.
            set -e
            [[ "$launchdStatus" -eq 0 ]] || exit "$launchdStatus"
